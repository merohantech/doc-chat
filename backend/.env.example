# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO

# Host-side URLs (running the API/tests outside Docker).
# docker-compose overrides these with the in-network hostnames.
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat
TEST_DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5433/chat_test
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=chat-backend

DEFAULT_CHAT_MODEL=anthropic/claude-haiku-5.5
UTILITY_MODEL=anthropic/claude-haiku-5.5
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

STORAGE_DIR=storage/uploads

# Chat behaviour
ALLOWED_CHAT_MODELS=["anthropic/claude-haiku-5.5","anthropic/claude-sonnet-5.5"]
CHAT_MAX_TOKENS=4096
MAX_MESSAGE_CHARS=32000
# 5m suits continuous chat; 1h pays off when users pause 5-60 min between messages.
PROMPT_CACHE_TTL=5m

# Until authentication exists, every request acts as this user.
DEV_USER_EMAIL=dev@localhost

# File uploads (sent to the model in full with the next message)
MAX_UPLOAD_BYTES=10485760
# ~20k tokens is roughly 25 pages of prose.
MAX_FILE_TOKENS=20000
